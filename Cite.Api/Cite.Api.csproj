<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Version>0.0.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <ProjectGuid>{ADD5ADE9-0369-480B-825C-19E5FC5081F7}</ProjectGuid>
    <LangVersion>latest</LangVersion>
    <UserSecretsId>cmu-sei-crucible-cite-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Globalization.Invariant" Value="true" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>
  <ItemGroup>
    <!-- A source generator: the mappings are generated at build time, so nothing ships at runtime. -->
    <PackageReference Include="Riok.Mapperly" Version="4.3.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.3.1" />
    <PackageReference Include="Z.EntityFramework.Plus.EFCore" Version="10.106.0" />
    <PackageReference Include="IdentityServer4.AccessTokenValidation" Version="3.0.1" />
    <PackageReference Include="TinCanStandard" Version="1.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Crucible.Common.ServiceDefaults" Version="0.0.3"/>
  </ItemGroup>
  <!-- Security pins. Referenced only to raise a package that otherwise arrives through another
       dependency at a vulnerable version; the test project inherits them through its project
       reference. Each can go once the dependency that brings it in carries a fixed version of its own. -->
  <ItemGroup>
    <!-- Through Microsoft.VisualStudio.Web.CodeGeneration.Design, which carries 6.12.1. -->
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
    <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
    <!-- Through Microsoft.Data.SqlClient, which carries 9.0.11 even under EF Core 10.0.13. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <!-- Through Swashbuckle.AspNetCore 10.0.1, which carries 2.3.0. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.13.0" />
    <!-- Through Microsoft.ApplicationInsights.AspNetCore 3.2.0, which carries 1.19.0. Crucible.Common.ServiceDefaults
         0.0.3 also brings it, at 1.15.0, which the advisory does not cover. -->
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
  </ItemGroup>
  <!-- Not security fixes. OpenTelemetry.Api and the SDK grant InternalsVisibleTo to the SDK, Extensions.Hosting
       and the exporters, so the whole family has to stay at one version. Microsoft.ApplicationInsights.AspNetCore
       3.2.0 raises the API and SDK to 1.19.1 and the pin above raises the API to 1.20.1, while
       Crucible.Common.ServiceDefaults 0.0.3 brings the exporters at 1.15.3. With the API pinned here too, an
       update that needs a newer OpenTelemetry.Api fails restore (NU1605) until this group moves with it. The
       group can go once every one of these packages resolves to the same version without it. -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Api" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Api.ProviderBuilderExtensions" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.20.1-beta.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cite.Api.Data\Cite.Api.Data.csproj" />
    <ProjectReference Include="..\Cite.Api.Migrations.PostgreSQL\Cite.Api.Migrations.PostgreSQL.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
